// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROFESSOR
  ALUNO
  EXTERNO
}

model User {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name") @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  mustChangePassword Boolean @default(false) @map("must_change_password")
  role      Role     @default(EXTERNO)
  
  school    School?  @relation(fields: [schoolId], references: [id])
  schoolId  Int?     @map("school_id")
  
  themes    Theme[]
  rankingPoints Int  @default(0) @map("ranking_points")
  gameMatches   GameMatch[]
  quizGames     QuizGame[]
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum WinType {
  NORMAL
  CARROCA
  LAILOA
  LAILOA_CARROCA
  TRANCOU_MENOS
  TRANCOU_EMPATE
}

model GameMatch {
  id        String   @id @default(uuid())
  winnerId  String?  @map("winner_id") // Optional because guests won't tie to User
  winType   WinType  @map("win_type")
  points    Int
  roomId    String?  @map("room_id")
  
  themeId   String?  @map("theme_id")
  theme     Theme?   @relation(fields: [themeId], references: [id])
  
  winner    User?    @relation(fields: [winnerId], references: [id])
  
  createdAt DateTime @default(now()) @map("created_at")

  @@map("game_matches")
}

model School {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  inep      String?  @unique @db.VarChar(50)
  address   String?  @db.Text
  phone     String?  @db.VarChar(50)
  email     String?  @db.VarChar(100)
  cnpj      String?  @db.VarChar(50)
  director  String?  @db.VarChar(255)
  
  users     User[]
  
  createdAt DateTime @default(now()) @map("created_at")

  @@map("schools")
}

model Category {
  id         Int           @id @default(autoincrement())
  name       String        @unique @db.VarChar(255)
  isDefault  Boolean       @default(false) @map("is_default")
  isApproved Boolean       @default(true) @map("is_approved") // Default ones are approved
  themes     Theme[]
  subs       SubCategory[]
  createdAt  DateTime      @default(now()) @map("created_at")

  @@map("categories")
}

model SubCategory {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  isDefault  Boolean  @default(false) @map("is_default")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int      @map("category_id")
  themes     Theme[]
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("subcategories")
}

model Theme {
  id            String       @id @default(uuid())
  name          String       @db.VarChar(255)
  description   String?      @db.Text
  color         String       @default("#009660") @db.VarChar(50)
  isPublic      Boolean      @default(false) @map("is_public")
  isApproved    Boolean      @default(false) @map("is_approved") // Custom themes need approval
  
  owner         User?        @relation(fields: [ownerId], references: [id])
  ownerId       String?      @map("owner_id")
  
  // Array of 6 image URLs (for pieces 1-6, 0 is blank)
  symbols       String[]     @default([])
  
  summary       String?      @db.Text
  
  category      Category     @relation(fields: [categoryId], references: [id])
  categoryId    Int          @map("category_id")
  
  subcategory   SubCategory?  @relation(fields: [subcategoryId], references: [id])
  subcategoryId Int?         @map("subcategory_id")
  
  gameMatches   GameMatch[]
  
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("themes")
}

// ─── XADREZ ────────────────────────────────────────────────────────────────

enum ChessGameStatus {
  WAITING    // aguardando 2º jogador
  PLAYING    // partida em andamento
  FINISHED   // partida encerrada
  ABANDONED  // jogador abandonou
}

enum ChessResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
}

enum ChessGameMode {
  PVP        // player vs player
  PVC        // player vs computador
}

model ChessGame {
  id          String           @id @default(uuid())
  roomCode    String           @unique @map("room_code") @db.VarChar(20)
  mode        ChessGameMode    @default(PVP)
  status      ChessGameStatus  @default(WAITING)
  result      ChessResult?

  // FEN da posição atual (notação padrão de xadrez)
  fen         String           @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  // Histórico de jogadas em notação algébrica (SAN)
  moves       String[]         @default([])

  // Brancas
  whiteId     String?          @map("white_id")
  whiteName   String?          @map("white_name") @db.VarChar(255)

  // Pretas
  blackId     String?          @map("black_id")
  blackName   String?          @map("black_name") @db.VarChar(255)

  // Nível da IA (1-10), apenas para PVC
  aiLevel     Int?             @default(5) @map("ai_level")

  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  finishedAt  DateTime?        @map("finished_at")

  @@map("chess_games")
}

model ChessRanking {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  userName  String   @map("user_name") @db.VarChar(255)
  schoolId  Int?     @map("school_id")
  schoolName String? @map("school_name") @db.VarChar(255)

  wins      Int      @default(0)
  losses    Int      @default(0)
  draws     Int      @default(0)
  points    Int      @default(0)   // wins*3 + draws*1

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chess_ranking")
}

// ─── XADREZ DA VELHA ─────────────────────────────────────────────────────

enum VelhaGameStatus {
  WAITING    // aguardando 2º jogador
  PLAYING    // partida em andamento
  FINISHED   // partida encerrada
  ABANDONED  // jogador abandonou
}

enum VelhaResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
}

enum VelhaGameMode {
  PVP        // player vs player
  PVC        // player vs computador
}

model VelhaGame {
  id          String          @id @default(uuid())
  roomCode    String          @unique @map("room_code") @db.VarChar(20)
  mode        VelhaGameMode   @default(PVP)
  status      VelhaGameStatus @default(WAITING)
  result      VelhaResult?

  // Estado final do tabuleiro (array de 9 posições)
  boardState  String[]        @default([])
  // Histórico de jogadas 
  moves       String[]        @default([])

  whiteId     String?         @map("white_id")
  whiteName   String?         @map("white_name") @db.VarChar(255)
  blackId     String?         @map("black_id")
  blackName   String?         @map("black_name") @db.VarChar(255)
  aiLevel     Int?            @default(3) @map("ai_level")

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  finishedAt  DateTime?       @map("finished_at")

  @@map("velha_games")
}

model VelhaRanking {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  userName   String   @map("user_name") @db.VarChar(255)
  schoolId   Int?     @map("school_id")
  schoolName String?  @map("school_name") @db.VarChar(255)

  wins       Int      @default(0)
  losses     Int      @default(0)
  draws      Int      @default(0)
  points     Int      @default(0)   // wins*3 + draws*1

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("velha_ranking")
}

// ─── BATALHA DOS PEÕES ────────────────────────────────────────────────────

enum PeaoGameStatus {
  WAITING    // aguardando 2º jogador
  PLAYING    // partida em andamento
  FINISHED   // partida encerrada
  ABANDONED  // jogador abandonou
}

enum PeaoResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
}

enum PeaoGameMode {
  PVP        // player vs player
  PVC        // player vs computador
}

model PeaoGame {
  id          String         @id @default(uuid())
  roomCode    String         @unique @map("room_code") @db.VarChar(20)
  mode        PeaoGameMode   @default(PVP)
  status      PeaoGameStatus @default(WAITING)
  result      PeaoResult?

  // Histórico de jogadas (ex: "48->40")
  moves       String[]       @default([])

  whiteId     String?        @map("white_id")
  whiteName   String?        @map("white_name") @db.VarChar(255)
  blackId     String?        @map("black_id")
  blackName   String?        @map("black_name") @db.VarChar(255)
  aiLevel     Int?           @default(3) @map("ai_level")

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  finishedAt  DateTime?      @map("finished_at")

  @@map("peao_games")
}

model PeaoRanking {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  userName   String   @map("user_name") @db.VarChar(255)
  schoolId   Int?     @map("school_id")
  schoolName String?  @map("school_name") @db.VarChar(255)

  wins       Int      @default(0)
  losses     Int      @default(0)
  draws      Int      @default(0)
  points     Int      @default(0)   // wins*3 + draws*1

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("peao_ranking")
}

// ─── QUIZ ─────────────────────────────────────────────────────────────────

enum QuizType {
  PEDAGOGICO    // Vinculado à BNCC — impacta diagnóstico
  COMEMORATIVO  // Quiz livre, sem vínculo curricular
}

enum QuizStatus {
  DRAFT       // Rascunho — não visível para alunos
  SCHEDULED   // Agendado
  LIVE        // Ao vivo — ativo agora
  ASYNC       // Modo assíncrono (prazo aberto)
  FINISHED    // Encerrado
}

enum StudentLevel {
  INICIANTE      // < 40% de acerto nas habilidades avaliadas
  EM_CONSTRUCAO  // 40–69%
  PROFICIENTE    // 70–89%
  AVANCADO       // >= 90%
}

model QuizGame {
  id            String      @id @default(uuid())
  title         String      @db.VarChar(255)
  description   String?     @db.Text
  type          QuizType    @default(PEDAGOGICO)
  status        QuizStatus  @default(DRAFT)

  // Vínculo curricular (opcional para COMEMORATIVO)
  discipline    String?     @db.VarChar(100)  // Ex: "Matemática", "Língua Portuguesa"
  educStage     String?     @db.VarChar(50)   // Ex: "Ensino Fundamental"
  yearGrade     String?     @db.VarChar(20)   // Ex: "5º Ano"

  // Configurações do quiz
  timePerQuestion Int       @default(30) @map("time_per_question") // segundos
  roomCode        String?   @unique @map("room_code") @db.VarChar(20)
  isPublic        Boolean   @default(false) @map("is_public")
  shuffleQuestions Boolean  @default(true) @map("shuffle_questions")
  shuffleAnswers  Boolean   @default(true) @map("shuffle_answers")

  // Vínculo com criador
  createdBy     User        @relation(fields: [createdById], references: [id])
  createdById   String      @map("created_by_id")

  questions     QuizQuestion[]
  sessions      QuizSession[]

  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("quiz_games")
}

model QuizQuestion {
  id            String      @id @default(uuid())
  quiz          QuizGame    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId        String      @map("quiz_id")

  // Código BNCC (ex: EF05CO03 ou EF05MA01) — opcional para COMEMORATIVO
  bnccCode      String?     @db.VarChar(30) @map("bncc_code")
  bnccSkill     String?     @db.Text @map("bncc_skill")       // Texto da habilidade BNCC

  questionText  String      @db.Text @map("question_text")
  imageUrl      String?     @db.VarChar(500) @map("image_url") // Imagem opcional na questão
  order         Int         @default(0)

  answers       QuizAnswer[]
  responses     QuizResponse[]

  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("quiz_questions")
}

model QuizAnswer {
  id            String       @id @default(uuid())
  question      QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId    String       @map("question_id")

  answerText    String       @db.Text @map("answer_text")
  isCorrect     Boolean      @default(false) @map("is_correct")
  imageUrl      String?      @db.VarChar(500) @map("image_url")
  order         Int          @default(0)

  responses     QuizResponse[]

  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("quiz_answers")
}

model QuizSession {
  id            String      @id @default(uuid())
  quiz          QuizGame    @relation(fields: [quizId], references: [id])
  quizId        String      @map("quiz_id")

  // Participante (pode ser usuário autenticado ou convidado)
  userId        String?     @map("user_id")
  userName      String      @db.VarChar(255) @map("user_name")
  schoolId      Int?        @map("school_id")

  // Resultados agregados da sessão
  totalQuestions  Int       @default(0) @map("total_questions")
  correctAnswers  Int       @default(0) @map("correct_answers")
  totalPoints     Int       @default(0) @map("total_points")
  timeSpentSecs   Int       @default(0) @map("time_spent_secs")
  completedAt     DateTime? @map("completed_at")

  // Nível diagnóstico calculado ao final
  studentLevel  StudentLevel? @map("student_level")

  responses     QuizResponse[]

  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("quiz_sessions")
}

model QuizResponse {
  id            String       @id @default(uuid())
  session       QuizSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId     String       @map("session_id")

  question      QuizQuestion @relation(fields: [questionId], references: [id])
  questionId    String       @map("question_id")

  answer        QuizAnswer?  @relation(fields: [answerId], references: [id])
  answerId      String?      @map("answer_id")

  isCorrect     Boolean      @default(false) @map("is_correct")
  timeTakenSecs Int          @default(0) @map("time_taken_secs")

  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("quiz_responses")
}

model BnccSkill {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(30) @map("code")
  stage       String   @db.VarChar(100) @map("stage")       // Etapa/Ano
  component   String?  @db.VarChar(100) @map("component")   // Componente Curricular (ex: Computação, Arte)
  axis        String?  @db.VarChar(100) @map("axis")        // Eixo ou Unidade Temática
  topic       String   @db.Text @map("topic")               // Objeto de Conhecimento
  description String   @db.Text @map("description")         // Habilidade (BNCC)
  pedagogical String?  @db.Text @map("pedagogical")         // Explicação Pedagógica
  activity    String?  @db.Text @map("activity")            // Atividade Proposta
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("bncc_skills")
}
