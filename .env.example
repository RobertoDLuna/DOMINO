# ============================================================
# VARIÁVEIS DE AMBIENTE - DOMINO GAME
# ============================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env no Git!
# No deploy (Portainer), configure essas variáveis diretamente
# na aba "Environment variables" da Stack.
# ============================================================

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://USUARIO:SENHA@postgres:5432/domino_db?schema=public

# Senha do PostgreSQL (usada pelo container postgres)
POSTGRES_PASSWORD=SUA_SENHA_AQUI

# Chave secreta para assinatura dos tokens JWT
# Gere uma chave forte: openssl rand -base64 32
JWT_SECRET=SUA_CHAVE_JWT_AQUI
